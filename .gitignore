# Ikaros local ignores.

# Project runtime / local state
.temp/
.ikaros/
/.secrets/
/secrets/

# Local environment files
.env
.env.*
!.env.example
!.env.sample
!.env.template
**/.venv/

# Rust / Cargo build artifacts
**/target/
**/*.rs.bk

# Logs and scratch files
*.log
*.log.*
*.tmp
*.temp

# Python build and test artifacts
**/__pycache__/
**/.mypy_cache/
**/.pytest_cache/
**/.ruff_cache/
**/*.py[cod]

# Ikaros desktop build and test artifacts
/ikaros/desktop/node_modules/
/ikaros/desktop/out/
/ikaros/desktop/dist/
/ikaros/desktop/coverage/
/ikaros/desktop/test-results/
/ikaros/desktop/playwright-report/
/ikaros/desktop/*.tsbuildinfo
/ikaros/desktop/**/*.tsbuildinfo

# Local agent/tooling state
.claude/settings.local.json
CONTEXT.md
